        "name": "write_file",
        "rawArguments": "{\"path\": \"src/state.mjs\", \"content\": \"import { finishField, finishRecord, drainRows } from './assembler.mjs';\\nimport { syntax } from './escape.mjs';\\nimport { consumeLine } from './line.mjs';\\n\\nexport function createState() {\\n  return {\\n    field: '',\\n    fields: [],\\n    rows: [],\\n    mode: 'plain', // 'plain' | 'quoted' | 'afterQuote'\\n    atFieldStart: true,\\n    pendingCR: false,\\n    touched: false,\\n  };\\n}\\n\\nexport function feedChar(state, char) {\\n  if (state.pendingCR) {\\n    state.pendingCR = false;\\n    if (char !== '\\\\n') throw syntax('BARE_CR');\\n    consumeLine(state);\\n    return;\\n  }\\n\\n  if (state.mode === 'quoted') {\\n    if (char === '\\\"') state.mode = 'afterQuote';\\n    else state.field += char;\\n    return;\\n  }\\n\\n  if (state.mode === 'afterQuote') {\\n    if (char === '\\\"') {\\n      // Doubled quote: one literal quote, stay inside the quoted field.\\n      state.field += '\\\"';\\n      state.mode = 'quoted';\\n      return;\\n    }\\n    if (char === ',') {\\n      finishField(state);\\n      state.mode = 'plain';\\n      state.touched = true;\\n      return;\\n    }\\n    if (char === '\\\\r') {\\n      finishField(state);\\n      state.mode = 'plain';\\n      state.pendingCR = true;\\n      return;\\n    }\\n    if (char === '\\\\n') {\\n      finishField(state);\\n      state.mode = 'plain';\\n      consumeLine(state);\\n      return;\\n    }\\n    throw syntax('INVALID_QUOTE');\\n  }\\n\\n  // plain mode\\n  if (char === ',') {\\n    finishField(state);\\n    state.touched = true;\\n    return;\\n  }\\n  if (char === '\\\\r') {\\n    finishField(state);\\n    state.pendingCR = true;\\n    return;\\n  }\\n  if (char === '\\\\n') {\\n    finishField(state);\\n    consumeLine(state);\\n    return;\\n  }\\n  if (char === '\\\"') {\\n    if (!state.atFieldStart) throw syntax('INVALID_QUOTE');\\n    state.mode = 'quoted';\\n    state.touched = true;\\n    return;\\n  }