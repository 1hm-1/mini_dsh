        "rawArguments": "{\"path\": \"ranges.mjs\", \"content\": \"export function mergeRanges(ranges) {\\n  if (!Array.isArray(ranges)) {\\n    throw new TypeError('mergeRanges expects an array of [start, end] pairs');\\n  }\\n\\n  const pairs = ranges.map((pair, index) => {\\n    if (!Array.isArray(pair) || pair.length !== 2) {\\n      throw new TypeError(`ranges[${index}] must be a [start, end] pair`);\\n    }\\n    const [start, end] = pair;\\n    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end)) {\\n      throw new TypeError(`ranges[${index}] bounds must be safe integers`);\\n    }\\n    if (start > end) {\\n      throw new TypeError(`ranges[${index}] start must not exceed end`);\\n    }\\n    return [start, end];\\n  });\\n\\n  pairs.sort((a, b) => a[0] - b[0] || a[1] - b[1]);\\n\\n  const output = [];\\n  for (const [start, end] of pairs) {\\n    const last = output[output.length - 1];\\n    if (last !== undefined && start <= last[1] + 1) {\\n      if (end > last[1]) last[1] = end;\\n    } else {\\n      output.push([start, end]);\\n    }\\n  }\\n  return output;\\n}\\n\"}",
