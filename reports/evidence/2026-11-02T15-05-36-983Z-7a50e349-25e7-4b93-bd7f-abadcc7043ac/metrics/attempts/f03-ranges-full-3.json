        "rawArguments": "{\"path\": \"ranges.mjs\", \"content\": \"export function mergeRanges(ranges) {\\n  if (!Array.isArray(ranges)) {\\n    throw new TypeError('ranges must be an array');\\n  }\\n\\n  const pairs = ranges.map((pair) => {\\n    if (!Array.isArray(pair) || pair.length !== 2) {\\n      throw new TypeError('each range must be a [start, end] pair');\\n    }\\n    const [start, end] = pair;\\n    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end)) {\\n      throw new TypeError('range bounds must be safe integers');\\n    }\\n    if (start > end) {\\n      throw new TypeError('range start must be <= end');\\n    }\\n    return [start, end];\\n  });\\n\\n  if (pairs.length === 0) return [];\\n\\n  pairs.sort((a, b) => a[0] - b[0] || a[1] - b[1]);\\n\\n  const output = [[pairs[0][0], pairs[0][1]]];\\n  for (let i = 1; i < pairs.length; i += 1) {\\n    const [start, end] = pairs[i];\\n    const last = output[output.length - 1];\\n    if (start <= last[1] + 1) {\\n      if (end > last[1]) last[1] = end;\\n    } else {\\n      output.push([start, end]);\\n    }\\n  }\\n  return output;\\n}\\n\"}",
