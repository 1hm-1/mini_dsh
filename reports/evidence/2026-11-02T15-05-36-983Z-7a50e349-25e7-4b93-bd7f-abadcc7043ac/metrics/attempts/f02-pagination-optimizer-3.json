        "rawArguments": "{\"path\": \"pagination.mjs\", \"content\": \"export function paginate(items, page, pageSize) {\\n  if (!Array.isArray(items)) {\\n    throw new TypeError('items must be an array');\\n  }\\n  if (!Number.isSafeInteger(page) || page < 1) {\\n    throw new RangeError('page must be a positive safe integer');\\n  }\\n  if (!Number.isSafeInteger(pageSize) || pageSize < 1) {\\n    throw new RangeError('pageSize must be a positive safe integer');\\n  }\\n\\n  const totalPages = Math.ceil(items.length / pageSize);\\n  const start = (page - 1) * pageSize;\\n  const selected = start < items.length ? items.slice(start, start + pageSize) : [];\\n\\n  return {\\n    items: selected,\\n    totalPages,\\n    nextPage: page < totalPages ? page + 1 : null,\\n  };\\n}\\n\"}",
