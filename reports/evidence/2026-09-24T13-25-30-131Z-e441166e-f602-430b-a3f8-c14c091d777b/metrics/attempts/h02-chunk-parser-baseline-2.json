l(parseRows([' a , b ']), [[' a ', ' b ']]);\\n  assert.deepEqual(parseRows([',']), [['', '']]);\\n});\\n\\ntest('type errors', () => {\\n  assert.throws(() => parseRows('a'), TypeError);\\n  assert.throws(() => parseRows([1]), TypeError);\\n});\\n\\ntest('consumers', () => {\\n  assert.deepEqual(readItems(['a,one\\\\nb,two']), [{ id: 'a', note: 'one' }, { id: 'b', note: 'two' }]);\\n  assert.equal(countItems(['a,one\\\\nb,two']), 2);\\n  assert.throws(() => readItems(['a,b,c']), e => e.code === 'COLUMN_COUNT');\\n  assert.throws(() => countItems(['a,b,c']), e => e.code === 'COLUMN_COUNT');\\n  assert.throws(() => readItems([',x']), e => e.code === 'EMPTY_ID');\\n  assert.throws(() => countItems([',x']), e => e.code === 'EMPTY_ID');\\n  assert.throws(() => readItems(['\\\"a']), e => e.code === 'UNTERMINATED_QUOTE');\\n});\\n\\ntest('chunking invariance', () => {\\n  const joined = 'a,\\\"x,y\\\"\\\\r\\\\nb,\\\"say \\\"\\\"hi\\\"\\\"\\\"\\\\n\\\\nc,';\\n  const expected = parseRows([joined]);\\n  for (let i = 0; i <= joined.length; i++) {\\n    assert.deepEqual(parseRows([joined.slice(0, i), joined.slice(i)]), expected);\\n  }\\n});\\n\"}",
