 export function createState() {
   return { field: '', fields: [], rows: [], mode: 'plain', atFieldStart: true, pendingCR: false, touched: false };
 }
 
 export function feedChar(state, char) {
   if (state.pendingCR) {
     consumeLine(state, char);
     return;
   }
   if (state.mode === 'quoted') {
